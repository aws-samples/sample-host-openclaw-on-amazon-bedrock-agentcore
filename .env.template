# Copy this file to .env, .env.dev, or .env.prod, fill in the values you need,
# then run ./scripts/deploy.sh.
#
# Default behavior:
#   ./scripts/deploy.sh
# loads ./.env
#
# Alternate env files:
#   ./scripts/deploy.sh --env dev
#   ./scripts/deploy.sh --env prod
#   OPENCLAW_ENV_FILE=.env.dev  ./scripts/deploy.sh   # explicit file override still works
#   OPENCLAW_ENV_FILE=.env.prod ./scripts/deploy.sh
#
# If you use --env <name>, keep OPENCLAW_ENV_SUFFIX aligned with that name.
# Example: .env.prod should usually set OPENCLAW_ENV_SUFFIX=prod.

# Environment name / suffix used for stack names and secret IDs.
OPENCLAW_ENV_SUFFIX=dev

# Deployment region. Leave aligned with cdk.json unless you intentionally override it.
CDK_DEFAULT_REGION=us-east-1

# Recommended when AgentCore Runtime in your region supports only specific AZs:
# stable AZ IDs supported by AgentCore Runtime in this region.
# The deploy script resolves these IDs to your account's AZ names and uses
# those names when creating the VPC, so the VPC subnets match AgentCore's needs.
# This is the preferred solution because AZ names like us-east-1a are
# account-specific aliases, while AZ IDs like use1-az1 are stable across accounts.
# Example (from an AgentCore error message in us-east-1):
AGENTCORE_SUPPORTED_AZ_IDS=use1-az4,use1-az1,use1-az2

# Shared Bedrock invocation logging is account+region-wide, not per suffix.
# Set this to true in exactly one environment in a given account+region
# (typically prod), and leave it false in the others.
# Example:
#   .env.prod -> MANAGE_BEDROCK_INVOCATION_LOGGING=true
#   .env.dev  -> MANAGE_BEDROCK_INVOCATION_LOGGING=false
MANAGE_BEDROCK_INVOCATION_LOGGING=false

# Stateful resource retention toggle.
# true  -> keep DynamoDB tables, selected log groups, KMS key, Cognito pool, and buckets on stack destroy
# false -> destroy those stack-managed resources instead; S3 buckets use auto-delete so they can be removed even when not empty
RETAIN_STATEFUL_RESOURCES=true

# Optional AWS CLI profile for deploy and setup commands.
# AWS_PROFILE=default

# Optional Telegram bootstrap during deploy:
# - stores the bot token in Secrets Manager
# - registers the webhook with API Gateway
# - allowlists your Telegram account
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=

# Optional E2E settings
E2E_TELEGRAM_CHAT_ID=
E2E_TELEGRAM_USER_ID=
