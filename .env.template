# Optional per-environment settings for scripts/deploy.sh, scripts/undeploy.sh
# and the scripts/setup-*.sh helpers. Copy this file and fill in what you need:
#
#   cp .env.template .env        # loaded by default
#   cp .env.template .env.dev    # loaded by ./scripts/deploy.sh --env dev
#   OPENCLAW_ENV_FILE=path/to/file ./scripts/deploy.sh   # explicit file
#
# .env and .env.* are git-ignored. Do not put secrets (bot tokens, keys) here;
# store them in Secrets Manager as described in the README.

# Suffix for stack and resource names: OpenClawRouter-dev, openclaw-identity-dev,
# openclaw/channels/telegram-dev, openclaw_agent_v2_dev, ...
# Leave empty to keep the original names (an existing deployment stays as is).
# --env NAME sets it to NAME; if you set it here as well, the two must match.
# Lowercase letters, digits and single hyphens, at most 12 characters.
OPENCLAW_ENV_SUFFIX=

# Deployment region (otherwise cdk.json "region", then the AWS CLI default).
# CDK_DEFAULT_REGION=us-west-2

# AWS CLI profile for the deploy and setup commands.
# AWS_PROFILE=

# Bedrock model invocation logging is one setting per account and region, so
# exactly one environment there should manage it. By default the unsuffixed
# environment does and suffixed ones reuse /aws/bedrock/invocation-logs.
# Set true for a suffixed environment that is alone in its account/region,
# or false for an unsuffixed one that shares the account with another owner.
# MANAGE_BEDROCK_INVOCATION_LOGGING=
